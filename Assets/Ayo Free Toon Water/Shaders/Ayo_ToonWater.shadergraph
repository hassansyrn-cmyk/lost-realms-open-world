    },
    "m_SourceType": 1,
    "m_FunctionName": "MainLightData",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(UNIVERSAL_LIGHTING_INCLUDED) && !defined(SHADERGRAPH_PREVIEW)\r\n    float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\r\n    Light mainLight = GetMainLight(shadowCoord);\n    Direction = mainLight.direction;\r\n    ShadowAtten = mainLight.shadowAttenuation;\r\n#else\r\n    Direction = float3(1, 1, -0.4);\n    ShadowAtten = 1.0;\r\n#endif"
}

